# USB bench (public Postgres port on the VPS)
DATABASE_URL=postgres://myhero:CHANGE_ME@YOUR_DOKPLOY_HOST:5433/myhero

# Dokploy compose app: use the Postgres service Internal URL (host = appName, port 5432).
# That hostname only resolves on dokploy-network. Do not use 127.0.0.1 inside the app container.
# DATABASE_URL=postgres://myhero:CHANGE_ME@postgres-APPNAME:5432/myhero

# Optional: pushed over USB after a passing flash (firmware must handle MHCFG)
# BENCH_WIFI_SSID=
# BENCH_WIFI_PASSWORD=

# Bind address. 0.0.0.0 lets kits on the LAN POST webhooks (127.0.0.1 does not).
# LISTEN_HOST=0.0.0.0

# Field kits POST to a URL they can reach (not 127.0.0.1). Same paths as the sketch:
#   POST /api/v1/sos/status   heartbeat  hash = stored status hash
#   POST /api/v1/sos/trigger  SOS press  hash = sha256(kitId-unknown-localTimeStamp-attemptNo-kitSecret)
#   POST /api/v1/sos/door     door       hash = sha256(kitId-triggeredBy-localTimeStamp-attemptNo-kitSecret)
# Aliases without /v1 also work. GET /api/v1/sos returns the contract.
# Status body: kitId, localTimeStamp, hash, plus extended fields when statusext=1.
# SOS body: kitId, triggeredBy, localTimeStamp, attemptNo, hash.
# Door body: kitId, triggeredBy, gpio, localTimeStamp, attemptNo, hash.

